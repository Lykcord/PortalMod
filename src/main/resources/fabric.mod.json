{
  "schemaVersion": 1,
  "id": "portalmod",
  "version": "${version}",
  "name": "PortalMod",
  "description": "Portal in Minecraft, reimagined.",
  "authors": [
    "SerialSniper",
    "PhantomEye",
    "LarsMans"
  ],
  "contact": {
    "homepage": "https://portalmod.net/",
    "sources": "https://github.com/snowy-shack/PortalMod"
  },
  "license": "All rights reserved",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.portalmod.PortalMod"
    ],
    "client": [
      "net.portalmod.client.PortalModClient"
    ],
    "fabric-datagen": [
      "net.portalmod.core.datagen.DataGenInit"
    ]
  },
  "mixins": [
    "portalmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": ">=0.163.0+26.3"
